generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum WalletType {
  CASH
  BANK
  E_WALLET
  SAVINGS
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum TransactionSource {
  MANUAL
  AI_TEXT
  AI_VOICE
  AI_RECEIPT
  RECURRING
}

enum AiSourceType {
  TEXT
  VOICE
  RECEIPT
}

enum DraftStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DebtType {
  LEND    // Cho người khác vay
  BORROW  // Đi vay người khác
}

enum DebtStatus {
  ACTIVE
  SETTLED
  OVERDUE
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum FeedbackType {
  FEEDBACK
  BUG
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role            @default(USER)
  status        UserStatus      @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  accounts      Account[]
  sessions      Session[]
  wallets       Wallet[]
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  debtBooks     DebtBook[]
  recurringRules RecurringRule[]
  aiDrafts      AiTransactionDraft[]
  feedbackReports FeedbackReport[]
  chatConversations ChatConversation[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Wallet {
  id                  String          @id @default(cuid())
  userId              String
  name                String
  type                WalletType      @default(CASH)
  accountNumber       String?
  bankName            String?
  balance             BigInt          @default(0)
  initialBalance      BigInt          @default(0)
  color               String          @default("#06b6d4")
  icon                String          @default("wallet")
  isExcludedFromTotal Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]   @relation("SourceWallet")
  incomingTransfers   Transaction[]   @relation("DestinationWallet")
  savingsGoals        SavingsGoal[]
  recurringRules      RecurringRule[]

  @@index([userId])
  @@map("wallets")
}

model Category {
  id              String          @id @default(cuid())
  userId          String?
  name            String
  type            TransactionType @default(EXPENSE)
  icon            String          @default("tag")
  color           String          @default("#8b5cf6")
  isSystemDefault Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  budgets         Budget[]
  recurringRules  RecurringRule[]

  @@index([userId])
  @@map("categories")
}

model Transaction {
  id                   String            @id @default(cuid())
  userId               String
  walletId             String
  destinationWalletId  String?
  categoryId           String?
  amount               BigInt
  type                 TransactionType   @default(EXPENSE)
  date                 DateTime          @default(now())
  description          String
  note                 String?
  payee                String?
  tags                 String[]          @default([])
  imageUrl             String?
  source               TransactionSource @default(MANUAL)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet               Wallet            @relation("SourceWallet", fields: [walletId], references: [id], onDelete: Cascade)
  destinationWallet    Wallet?           @relation("DestinationWallet", fields: [destinationWalletId], references: [id], onDelete: SetNull)
  category             Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([walletId])
  @@index([categoryId])
  @@map("transactions")
}

model AiTransactionDraft {
  id                     String       @id @default(cuid())
  userId                 String
  rawInput               String       @db.Text
  sourceType             AiSourceType @default(TEXT)
  status                 DraftStatus  @default(PENDING)
  suggestedData          Json
  confirmedTransactionId String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("ai_transaction_drafts")
}

model Budget {
  id          String    @id @default(cuid())
  userId      String
  categoryId  String?
  month       Int
  year        Int
  limitAmount BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}

model SavingsGoal {
  id            String     @id @default(cuid())
  userId        String
  walletId      String?
  name          String
  targetAmount  BigInt
  currentAmount BigInt     @default(0)
  deadline      DateTime?
  color         String     @default("#10b981")
  icon          String     @default("target")
  status        GoalStatus @default(IN_PROGRESS)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet?    @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("savings_goals")
}

model DebtBook {
  id          String           @id @default(cuid())
  userId      String
  type        DebtType         @default(LEND)
  personName  String
  phone       String?
  totalAmount BigInt
  paidAmount  BigInt           @default(0)
  dueDate     DateTime?
  status      DebtStatus       @default(ACTIVE)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments  DebtRepayment[]

  @@index([userId, status])
  @@map("debt_books")
}

model DebtRepayment {
  id         String    @id @default(cuid())
  debtBookId String
  amount     BigInt
  walletId   String?
  date       DateTime  @default(now())
  note       String?
  createdAt  DateTime  @default(now())

  debtBook   DebtBook  @relation(fields: [debtBookId], references: [id], onDelete: Cascade)

  @@index([debtBookId])
  @@map("debt_repayments")
}

model RecurringRule {
  id            String          @id @default(cuid())
  userId        String
  walletId      String
  categoryId    String?
  amount        BigInt
  type          TransactionType @default(EXPENSE)
  description   String
  frequency     Frequency       @default(MONTHLY)
  isFixedAmount Boolean         @default(true)
  startDate     DateTime
  nextDueDate   DateTime
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@map("recurring_rules")
}

model FeedbackReport {
  id        String         @id @default(cuid())
  userId    String
  type      FeedbackType   @default(FEEDBACK)
  title     String
  content   String         @db.Text
  status    FeedbackStatus @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("feedback_reports")
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("Cuộc trò chuyện mới")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String           @db.Text
  metadata       Json?
  createdAt      DateTime         @default(now())

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
