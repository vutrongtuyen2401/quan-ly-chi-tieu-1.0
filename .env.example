# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:1@localhost:5432/quanlychitieu?schema=public"

# NextAuth / Auth.js Configuration
AUTH_SECRET="your-super-secret-key-min-32-chars-long-production-grade"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-long-production-grade"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (Optional: Cần thiết khi bật Google Sign-In thật)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI Integration (Optional: Cung cấp để dùng Google Gemini Vision & LLM; nếu không có, hệ thống tự động kích hoạt Rule-Based Vietnamese Financial NLP Engine cục bộ)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"
