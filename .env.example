# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG - HỆ THỐNG QUẢN LÝ CHI TIÊU 1.0
# ==============================================================================
# Sao chép tệp này thành .env trong môi trường phát triển cục bộ hoặc
# cấu hình trực tiếp trên bảng điều khiển hosting (Vercel, Railway, Render, Docker).

# ------------------------------------------------------------------------------
# 1. MÔI TRƯỜNG CHẠY ỨNG DỤNG (ENVIRONMENT)
# ------------------------------------------------------------------------------
# Giá trị: 'development', 'staging', hoặc 'production'
NODE_ENV="production"

# Bật tính năng đăng nhập nhanh tài khoản mẫu thử nghiệm (chỉ nên bật trên dev/staging)
# Trên Production: BẮT BUỘC đặt là false
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS="false"

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU (POSTGRESQL)
# ------------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL chính thức.
# Khuyến nghị Production: Sử dụng Connection Pooling (PgBouncer, Supabase Pooler, AWS RDS Proxy)
# Cú pháp: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public&connection_limit=20
DATABASE_URL="postgresql://postgres:secure_password_here@db-host.internal:5432/quanlychitieu?schema=public&connection_limit=20"

# Cho phép chạy seed đè dữ liệu trên production (Mặc định: không đặt hoặc false để bảo vệ an toàn)
# ALLOW_PRODUCTION_SEED="false"

# ------------------------------------------------------------------------------
# 3. BẢO MẬT & XÁC THỰC PHIÊN (AUTH.JS / NEXTAUTH)
# ------------------------------------------------------------------------------
# Khóa bí mật ký token phiên làm việc (Tối thiểu 32 ký tự ngẫu nhiên bảo mật cao)
# Tạo khóa ngẫu nhiên an toàn bằng terminal: openssl rand -base64 32
AUTH_SECRET="generate-a-strong-32-character-secret-key-for-production"
NEXTAUTH_SECRET="generate-a-strong-32-character-secret-key-for-production"

# Địa chỉ URL gốc của ứng dụng trên production (không có dấu / ở cuối)
# Ví dụ: https://quanlychitieu.vn hoặc https://my-app.vercel.app
NEXTAUTH_URL="https://your-production-domain.com"

# Bật tin cậy reverse proxy host (Cần thiết khi chạy sau Cloudflare, Vercel, Nginx)
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (TÙY CHỌN: ĐĂNG NHẬP BẰNG GOOGLE)
# ------------------------------------------------------------------------------
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials
# Redirect URI: https://your-production-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# 5. TRÍ TUỆ NHÂN TẠO GEMINI (GOOGLE AI STUDIO)
# ------------------------------------------------------------------------------
# API Key từ Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY="your-production-gemini-api-key"

# Tên mô hình Gemini được chỉ định (Hỗ trợ: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# Token bí mật bảo vệ endpoint giám sát sức khỏe /api/ai/health (Dành cho Uptime Kuma, Datadog)
# Khi cấu hình, request cần gửi header 'x-health-token: your-secret-token'
HEALTH_CHECK_SECRET="internal-health-monitor-secret-token-here"

# ------------------------------------------------------------------------------
# 6. GIỚI HẠN TẢI LÊN & AN TOÀN TỆP (FILE UPLOADS)
# ------------------------------------------------------------------------------
# Dung lượng tệp ảnh hóa đơn tối đa cho phép tải lên (tính bằng MB, mặc định 5MB)
MAX_UPLOAD_SIZE_MB="5"
